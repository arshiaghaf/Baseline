{
  "name": "baseline",
  "version": "0.5.2",
  "description": "Baseline is a standalone macOS Electron app for finding app updates through public update sources.",
  "main": ".vite/build/main.js",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "build": "electron-forge package",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:electron": "playwright test",
    "lint": "eslint .",
    "format": "prettier --check \"src/**/*.{ts,tsx,css}\" \"ElectronTests/**/*.{ts,tsx}\" \"e2e/**/*.ts\" \"*.{json,ts,js,cjs}\""
  },
  "keywords": [
    "macos",
    "electron",
    "updates",
    "homebrew"
  ],
  "author": "Arshia Ghaffarian",
  "license": "GPL-3.0-only",
  "type": "commonjs",
  "config": {
    "forge": "./forge.config.ts"
  },
  "dependencies": {
    "fast-xml-parser": "^5.10.1",
    "lucide-react": "^1.21.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "overrides": {
    "@tootallnate/once": "^3.0.1",
    "tar": "^7.5.16",
    "tmp": "^0.2.6"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/ui": "^4.1.9",
    "autoprefixer": "^10.5.2",
    "electron": "^42.5.0",
    "eslint": "^10.6.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.16",
    "prettier": "^3.9.1",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.0",
    "vitest": "^4.1.5"
  }
}
